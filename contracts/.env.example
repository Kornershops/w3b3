# Smart Contracts Environment Variables

# Private Key (DO NOT COMMIT)
PRIVATE_KEY=your_private_key_here

# Block Explorer API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# RPC Endpoints
ALCHEMY_API_KEY=your_alchemy_api_key

# Credit-line deployment preflight
# These values must match the connected chain and the already-deployed oracle.
CREDIT_EXPECTED_CHAIN_ID=your_chain_id
CREDIT_BORROW_ASSET=0x0000000000000000000000000000000000000000
CREDIT_COLLATERAL_ASSET=0x0000000000000000000000000000000000000000
CREDIT_ORACLE=0x0000000000000000000000000000000000000000
CREDIT_ORACLE_FEED=0x0000000000000000000000000000000000000000
CREDIT_ORACLE_MAX_AGE_SECONDS=your_max_age_seconds
CREDIT_OWNER=0x0000000000000000000000000000000000000000

# Gas Reporter
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
