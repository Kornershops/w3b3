# Backend Environment Variables

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication secrets: use unique high-entropy values in production.
JWT_SECRET=replace_with_high_entropy_secret
JWT_REFRESH_SECRET=replace_with_high_entropy_refresh_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_SECRET=replace_with_high_entropy_admin_secret

# Authoritative Web3 connectivity. Production must provide a non-local RPC.
WEB3_RPC_URL=https://your-authoritative-rpc.example
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_API_KEY=your_infura_api_key
ALCHEMY_WEBHOOK_SIGNING_KEY=your_webhook_signing_key
ALCHEMY_GAS_POLICY_ID=your_alchemy_gas_policy_id

# Production treasury identity. Must be a valid, non-zero address.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
