# W3B3 Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_RPC_PROVIDER=infura

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

RPC_PROVIDER_KEY=your_infura_or_alchemy_key

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ============================================
# SMART CONTRACTS ENVIRONMENT VARIABLES
# ============================================

PRIVATE_KEY=your_deployer_private_key_here

ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
SOLSCAN_API_KEY=your_solscan_api_key

ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_key
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_key

# ============================================
# MONITORING & ANALYTICS
# ============================================

SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
LOGROCKET_ID=your_logrocket_id

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_vercel_project_id

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_MEMECOIN_POOLS=true
ENABLE_REFERRAL_SYSTEM=false
ENABLE_GOVERNANCE=false
MAINTENANCE_MODE=false
